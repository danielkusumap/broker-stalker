# ============================================================
# Broker Stalker — template konfigurasi
# Salin file ini jadi .env lalu isi nilainya:
#   cp .env.example .env
# ============================================================

# Key API IDX Edge (ambil di https://stock.arjum.com → menu API Key)
# WAJIB. Tanpa key ini semua halaman yang butuh data IDX akan gagal.
IDX_API_KEY=isi-key-idx-edge-disini

# Lokasi database SQLite.
# Lokal (`npm run dev`): path relatif ke root project.
# Docker: dibiarkan /app/data/market.db (di-set oleh docker-compose.yml).
BS2_DB_PATH=./data/market.db

# Port web di host (nginx). Buka http://localhost:9101
APP_PORT=9101

# Login basic auth nginx — diminta sekali per sesi browser.
# GANTI sebelum dipakai di jaringan publik.
BASIC_AUTH_USER=stalker
BASIC_AUTH_PASSWORD=ganti-password-ini
